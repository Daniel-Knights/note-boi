{
  "name": "note-boi",
  "version": "4.2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Daniel-Knights/note-boi"
  },
  "type": "module",
  "scripts": {
    "vite:dev": "vite",
    "vite:build": "vite build",
    "vite:preview": "vite preview",
    "dev": "tauri dev",
    "dev:web": "vite --config vite.config.web.ts",
    "build": "pnpm run checks && tauri build",
    "build:web": "pnpm run checks && vite build --config vite.config.web.ts",
    "build:debug": "tauri build --debug",
    "preview:web": "pnpm run build:web && vite preview --config vite.config.web.ts",
    "icon": "tauri icon ./artwork/icon.png",
    "info": "tauri info",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:update": "vitest run -u",
    "lint": "eslint && vue-tsc --noEmit && tsc --noEmit",
    "checks": "pnpm run lint && pnpm run test",
    "format": "prettier --write ./src",
    "release:patch": "tsx ./scripts/release.ts patch",
    "release:minor": "tsx ./scripts/release.ts minor",
    "release:major": "tsx ./scripts/release.ts major"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "~2.6.0",
    "@tauri-apps/plugin-log": "~2.8.0",
    "@tauri-apps/plugin-process": "~2.3.1",
    "@tauri-apps/plugin-shell": "~2.3.5",
    "@tauri-apps/plugin-updater": "~2.10.1",
    "fflate": "^0.8.3",
    "quill": "^2.0.3",
    "vue": "^3.5.35"
  },
  "devDependencies": {
    "@babel/types": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.11.2",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/eslint": "^9.6.1",
    "@types/node": "^25.9.1",
    "@typescript-eslint/parser": "^8.60.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/test-utils": "2.4.10",
    "changenog": "^2.0.6",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.9.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.6.0",
    "jsdom": "^28.1.0",
    "prettier": "^3.8.3",
    "quill-delta": "^5.1.0",
    "sass-embedded": "1.97.3",
    "tsx": "^4.22.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.60.0",
    "vite": "^7.3.1",
    "vitest": "4.1.7",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^3.3.2"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.4.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.4.0"
    }
  }
}
